# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=spms_super_secret_lab_key_change_in_production

# Database Configuration (MySQL 8)
# Replace with your local MySQL credentials:
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_placement_db

# Optional direct URI override (takes precedence if provided)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/student_placement_db

# Fallback setting for testing or offline lab execution without active MySQL:
# Set USE_SQLITE_FALLBACK=true to automatically use SQLite if MySQL connection fails
USE_SQLITE_FALLBACK=true
